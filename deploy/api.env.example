DATABASE_MAX_CONNS=20
JWT_SECRET=replace-with-48-random-characters-0123456789abcdef
TRUSTED_PROXY_CIDRS=172.16.0.0/12
REQUEST_TIMEOUT=30s
SHUTDOWN_TIMEOUT=15s

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://api.example.com/v1/auth/google/callback

EMAIL_SENDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=afterword
SMTP_PASSWORD=replace-with-the-smtp-password
SMTP_FROM="Afterword <no-reply@example.com>"
SMTP_STARTTLS=true

SMS_SENDER=noop

S3_BUCKET_AUDIO=audio
S3_BUCKET_TRANSCRIPTS=transcripts
S3_BUCKET_CLIPS=clips
S3_BUCKET_EXPORTS=exports

PAYMENT_PROVIDER=nylonpay
ALLOW_FAKE_PAYMENTS=false
FREE_GRANT_MINUTES=300
GRANT_INTERVAL=1h
PAYMENT_PENDING_TTL=24h
CHECKOUT_RATE_LIMIT=10
CHECKOUT_RATE_WINDOW=1h
ADMIN_TOKEN=replace-with-32-random-characters-0123456789
NYLONPAY_BASE_URL=https://pay.example.com/api
NYLONPAY_API_KEY=replace-with-the-nylon-pay-api-key
NYLONPAY_WEBHOOK_SECRET=replace-with-the-nylon-pay-webhook-secret
