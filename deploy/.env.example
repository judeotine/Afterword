DOMAIN=example.com
ACME_EMAIL=ops@example.com
TAG=latest

POSTGRES_USER=afterword
POSTGRES_PASSWORD=replace-with-a-generated-password
POSTGRES_DB=afterword

DATABASE_URL=postgres://afterword:replace-with-a-generated-password@postgres:5432/afterword?sslmode=disable
DATABASE_MAX_CONNS=20

PORT=8080
LOG_LEVEL=info
JWT_SECRET=replace-with-48-random-characters-0123456789abcdef
APP_BASE_URL=https://app.example.com
API_BASE_URL=https://api.example.com
TRUSTED_PROXY_CIDRS=172.16.0.0/12
REQUEST_TIMEOUT=30s
SHUTDOWN_TIMEOUT=15s

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://api.example.com/v1/auth/google/callback

EMAIL_SENDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=afterword
SMTP_PASSWORD=replace-with-the-smtp-password
SMTP_FROM=Afterword <no-reply@example.com>
SMTP_STARTTLS=true

SMS_SENDER=noop

MINIO_ROOT_USER=afterword
MINIO_ROOT_PASSWORD=replace-with-a-generated-password

S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY=afterword
S3_SECRET_KEY=replace-with-a-generated-password
S3_REGION=us-east-1
S3_USE_SSL=true
S3_BUCKETS=audio transcripts clips exports
S3_BUCKET_AUDIO=audio
S3_BUCKET_TRANSCRIPTS=transcripts
S3_BUCKET_CLIPS=clips
S3_BUCKET_EXPORTS=exports

PRIVACY_URL=https://app.example.com/privacy
BOT_NAME=Afterword Notetaker
BOT_WORKER_REPLICAS=1
MAX_MEETING_MINUTES=180
ALONE_TIMEOUT_SECONDS=120
TRANSCRIBE_ENGINE=whisper
TRANSCRIBE_MODEL=base

BACKUP_HOUR_UTC=3
BACKUP_RETENTION_DAYS=30
BACKUP_PROVIDER=Cloudflare
BACKUP_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_REGION=auto
BACKUP_ACCESS_KEY=replace-with-the-offsite-access-key
BACKUP_SECRET_KEY=replace-with-the-offsite-secret-key
BACKUP_BUCKET=afterword-backups
BACKUP_PREFIX=afterword
